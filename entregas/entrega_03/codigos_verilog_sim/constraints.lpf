# Colorlight 5A-75E v8.2
# Panel HUB75 64x64
# Reloj 25 MHz

LOCATE COMP "clk" SITE "P6";
IOBUF PORT "clk" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk" 25 MHZ;

# HUB75 RGB superior
LOCATE COMP "r0" SITE "P7";
LOCATE COMP "g0" SITE "M7";
LOCATE COMP "b0" SITE "P8";

# HUB75 RGB inferior
LOCATE COMP "r1" SITE "R8";
LOCATE COMP "g1" SITE "M8";
LOCATE COMP "b1" SITE "M9";

# Dirección de fila
LOCATE COMP "addr[0]" SITE "N5";
LOCATE COMP "addr[1]" SITE "N3";
LOCATE COMP "addr[2]" SITE "P3";
LOCATE COMP "addr[3]" SITE "P4";
LOCATE COMP "addr[4]" SITE "N4";

# Control HUB75
LOCATE COMP "clk_out" SITE "M3";
LOCATE COMP "latch" SITE "N1";
LOCATE COMP "oe" SITE "M4";

# SPI
LOCATE COMP "spi_cs" SITE "D4";
LOCATE COMP "spi_sck" SITE "E4";
LOCATE COMP "spi_mosi" SITE "D3";

# Reset
LOCATE COMP "rst" SITE "R7";

# I/O RGB
IOBUF PORT "r0" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "g0" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "b0" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "r1" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "g1" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "b1" IO_TYPE=LVCMOS33 DRIVE=8;

# I/O dirección
IOBUF PORT "addr[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "addr[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "addr[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "addr[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "addr[4]" IO_TYPE=LVCMOS33 DRIVE=8;

# I/O control
IOBUF PORT "clk_out" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "latch" IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "oe" IO_TYPE=LVCMOS33 DRIVE=8;

# I/O reset y SPI
IOBUF PORT "rst" IO_TYPE=LVCMOS33;
IOBUF PORT "spi_cs" IO_TYPE=LVCMOS33;
IOBUF PORT "spi_sck" IO_TYPE=LVCMOS33;
IOBUF PORT "spi_mosi" IO_TYPE=LVCMOS33;
